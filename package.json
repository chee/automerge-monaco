{
	"name": "automerge-monaco",
	"description": "collaborative monaco-editor powered by automerge",
	"keywords": [
		"automerge",
		"monaco",
		"editor",
		"collaborative",
		"crdt"
	],
	"author": {
		"name": "chee"
	},
	"repository": {
		"url": "https://github.com/chee/automerge-monaco"
	},
	"version": "0.0.4",
	"type": "module",
	"files": [
		"dist",
		"index.d.ts"
	],
	"main": "./dist/automonaco.cjs",
	"module": "./dist/automonaco.js",
	"types": "./index.d.ts",
	"exports": {
		"types": "./index.d.ts",
		"import": "./dist/automonaco.js",
		"require": "./dist/automonaco.cjs"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"mk": "tsc && vite build"
	},
	"devDependencies": {
		"@automerge/automerge-repo": "2.0.0",
		"@automerge/vanillajs": "^2.0.0",
		"@monaco-editor/loader": "^1.5.0",
		"monaco-editor": "^0.52.2",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vite-plugin-monaco-editor": "^1.1.0",
		"vite-plugin-wasm": "^3.4.1"
	},
	"peerDependencies": {
		"@automerge/automerge-repo": "2.0.0",
		"monaco-editor": "^0.52.2"
	},
	"dependencies": {
		"vite-plugin-dts": "^4.5.4"
	}
}
